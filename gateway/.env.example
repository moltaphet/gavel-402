# Copy to .env and fill in. Never commit .env.
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-mini

# Kite network: "testnet" (eip155:2368, pieUSD) or "mainnet" (eip155:2366, USDC.e)
KITE_NETWORK=testnet
FACILITATOR_URL=https://facilitator.pieverse.io/v2
# Address that receives payments (the seller). Required.
PAY_TO=
# The paid API the gateway protects. Required.
UPSTREAM_URL=
PRICE_USD=0.001
PORT=8402
