# Copy to .env and fill in. Never commit .env.
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-mini

# Kite network: "testnet" (eip155:2368, pieUSD) or "mainnet" (eip155:2366, USDC.e)
KITE_NETWORK=testnet
FACILITATOR_URL=https://facilitator.pieverse.io/v2
# Address that receives payments (the seller). Required.
PAY_TO=
# The paid API the gateway protects. Required.
UPSTREAM_URL=
PRICE_USD=0.001
PORT=8402

# --- Appeals (optional). Leave GENLAYER_* empty to disable appeals. ---
# Bearer token (16+ chars) the seller uses to appeal a rejection.
ADMIN_TOKEN=
# studio-dev | studionet | bradbury | localnet
GENLAYER_NETWORK=studio-dev
GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
# The deployed DeliveryJudge contract (see contracts/DEPLOYMENTS.md).
GENLAYER_CONTRACT=
# Testnet-only account that signs and pays for court transactions. Never use a funded mainnet key.
GENLAYER_PRIVATE_KEY=
# 0 = settle immediately on ACCEPT. >0 holds an ACCEPT so the buyer can appeal;
# then MAX_TIMEOUT_SECONDS must be >= this + 180.
APPEAL_WINDOW_SECONDS=0
MAX_TIMEOUT_SECONDS=120
